# Public URL for this API. Configure this exact value in the hosting provider.
SERVER_URL=https://swiped-back.maximalsecurityservices.com

# Optional additional browser origins, separated by commas. Native mobile requests
# do not send an Origin header and are already supported by the CORS middleware.
ALLOWED_ORIGINS=https://swiped-dash.vercel.app,https://swipedmax-website.vercel.app,https://swiped-visit-us.vercel.app,https://access.maximalsecurityservices.com

# DigitalOcean Spaces upload credentials and origin. The endpoint remains private
# infrastructure; clients receive URLs on ASSET_PUBLIC_BASE_URL instead.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=swiped-bucket
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
ASSET_PUBLIC_BASE_URL=https://assets.maximalsecurityservices.com
